# emeye configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. Every variable emeye reads is
# declared in src/emeye/config.py; this file documents all of them.

# ---------------------------------------------------------------- required ---

# Warehouse password. No default — emeye refuses to start without it.
# Any non-empty string; it never leaves your machine.
EMEYE_POSTGRES_PASSWORD=change-me

# How emeye identifies itself to every upstream service. No default, and this
# is not a formality: the project's collection posture commits to identifying
# honestly, which means a real, reachable contact address. Never impersonate a
# browser here.
EMEYE_USER_AGENT=emeye/0.1 (personal research; +mailto:you@example.com)

# ---------------------------------------------------------------- database ---

EMEYE_POSTGRES_HOST=postgres
EMEYE_POSTGRES_PORT=5432
EMEYE_POSTGRES_DB=emeye
EMEYE_POSTGRES_USER=emeye

# ------------------------------------------------------------------- files ---

EMEYE_DATA_DIR=/data
EMEYE_EXPORT_DIR=/data/exports

# ------------------------------------------------------------ container UID --
#
# The app container runs as this UID/GID so bind-mounted files stay writable.
# Defaults to 1000, the first user on a standard Ubuntu install. If `id -u`
# says otherwise on your machine, set both and rebuild. Must not be 0 — the
# image builds a non-root user and UID 0 collides with root.
EMEYE_UID=1000
EMEYE_GID=1000

# --------------------------------------------------------- source switches ---
#
# All default to false. A collector that has been merged does not collect until
# it is switched on here — enabling collection is a deliberate act, never a
# side effect of pulling a new version.

EMEYE_ENABLE_BEATPORT=false
EMEYE_ENABLE_MUSICBRAINZ=false
EMEYE_ENABLE_DISCOGS=false
EMEYE_ENABLE_DEEZER=false
EMEYE_ENABLE_LASTFM=false
EMEYE_ENABLE_LISTENBRAINZ=false
EMEYE_ENABLE_SPOTIFY=false

# ----------------------------------------------------------- source tokens ---
#
# Optional. Only needed for the sources you switch on above.

# https://www.discogs.com/settings/developers
EMEYE_DISCOGS_TOKEN=

# https://www.last.fm/api/account/create
EMEYE_LASTFM_API_KEY=

# https://developer.spotify.com/dashboard — client-credentials flow
EMEYE_SPOTIFY_CLIENT_ID=
EMEYE_SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------- politeness ---

EMEYE_DEFAULT_RATE_LIMIT_PER_SEC=1.0
EMEYE_HTTP_TIMEOUT_SECONDS=30
EMEYE_MAX_RETRIES=5

# ---------------------------------------------------------------- logging ---

EMEYE_LOG_LEVEL=INFO
# Unset auto-detects: readable text on a terminal, JSON when piped.
# Set to true or false to force one.
#EMEYE_LOG_JSON=
EMEYE_SERVICE_NAME=emeye

# --------------------------------------------------------------- startup ----

# Seconds the container waits for postgres before failing with an explanation.
EMEYE_DB_WAIT_TIMEOUT=60
